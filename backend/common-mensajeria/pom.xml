<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>co.edu.proyecto</groupId>
        <artifactId>ecommerce-hibrido</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>common-mensajeria</artifactId>
    <packaging>jar</packaging>

    <!--
      Configuración de Kafka y RabbitMQ que comparten los servicios. Kafka, RabbitMQ y Jackson son opcionales:
      no viajan a quien depende de este módulo, así cada servicio solo tiene en su classpath lo que ya declara
      (analytics y el dashboard no reciben RabbitMQ). No hay escaneo ni autoconfiguración: cada servicio
      importa con @Import solo las clases que usa. EjecutorTarea (tareas/) se crea con @Bean en cada worker y
      worker-comun.yml se carga con spring.config.import solo en los workers.
    -->
    <dependencies>
        <dependency>
            <groupId>co.edu.proyecto</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Solo para EjecutorTareaTest: serializar Instant igual que el ObjectMapper de Spring Boot. -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
